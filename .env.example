# --- Server ---
PORT=3000
HOST=127.0.0.1
# Everything the tools can touch lives under this folder (relative or absolute)
WORKSPACE_ROOT=./workspace
# Generate with: npm run gen-token   (min 24 chars)
MCP_AUTH_TOKEN=replace-me-with-a-long-random-string
# Kill switch: set to false for a read-only server
ALLOW_WRITES=true
MAX_FILE_BYTES=1000000
AUDIT_LOG=./logs/audit.jsonl

# --- ngrok (used by ecosystem.config.cjs) ---
# Your free static domain from https://dashboard.ngrok.com/domains
NGROK_DOMAIN=your-name.ngrok-free.app
